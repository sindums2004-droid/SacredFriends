{
  "name": "sacred-friends-fullstack",
  "version": "2.0.0",
  "description": "Sacred Friends by Q-CUBIC — Windows Desktop Companion Application Website and Licensing Platform",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite --port 5173",
    "dev:backend": "node --watch backend/server.js",
    "dev:youpi": "node youpi-gateway/scripts/dev.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:youpi\"",
    "dev:lite": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:youpi\"",
    "setup:youpi": "cd youpi-gateway && npm install && npm run db:setup",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node backend/server.js",
    "test": "node backend/tests/test_runner.js",
    "render:video": "node backend/scripts/render_video.js"
  },
  "keywords": [
    "sacred-friends",
    "q-cubic",
    "desktop-companion",
    "windows",
    "licensing",
    "youpi-pg",
    "json-database"
  ],
  "author": "Q-CUBIC Innovations",
  "license": "UNLICENSED",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.1.2",
    "vite": "^8.3.5"
  }
}
