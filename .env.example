# Sacred Friends by Q-CUBIC — Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (e.g. mongodb://localhost:27017/sacred_friends or MongoDB Atlas URI)
# If MongoDB is unavailable, the server automatically uses local resilient fallback for testing.
MONGODB_URI=mongodb://127.0.0.1:27017/sacred_friends

# YouPI-PG Sovereign UPI Payment Gateway Configuration
# Local ports: Payment API = 6100, Checkout Portal = 7000, Control Center = 8090, Merchant Admin = 6001
YOUPI_PAYMENT_API_URL=http://localhost:6100
YOUPI_CHECKOUT_URL=http://localhost:7000
YOUPI_MERCHANT_ID=00000000-0000-0000-0000-000000000001
YOUPI_MERCHANT_KEY=mk_live_c12afcf0460bc5593179e0b9c25d871d1a6d00afe0494f66
YOUPI_WEBHOOK_SECRET=d86590211edbe497f040a7b0f4e639527151a414a7fd7f8754bdd4d845ca1d1a

# Legacy Payment Gateway Credentials (Optional / Deprecated)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# V2 Premium Pricing (in INR or USD)
# If not configured or empty, the site displays: "Premium price is not yet available."
V2_PREMIUM_PRICE=499
V2_PREMIUM_CURRENCY=INR

# Admin Secret Key for Device Reset and Management APIs
ADMIN_SECRET_KEY=sacred-friends-super-admin-secret-2026

# Server Base URL (for generated authorized download links)
SERVER_BASE_URL=http://localhost:5000

